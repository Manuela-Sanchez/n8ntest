    {
      "parameters": {
        "jsCode": "// Calcular totales con IVA español\nconst items = $input.all();\nconst processedItems = [];\n\nfor (const item of items) {\n  const data = item.json;\n  \n  // Validar datos\n  const montoBase = parseFloat(data.monto_base) || 0;\n  const ivaRate = parseFloat(data.iva_rate) || 0.21;\n  const diasVencimiento = parseInt(data.dias_vencimiento) || 30;\n  \n  // Calcular montos\n  const ivaMonto = Math.round(montoBase * ivaRate * 100) / 100;\n  const montoTotal = Math.round((montoBase + ivaMonto) * 100) / 100;\n  \n  // Generar ID único de factura\n  const today = new Date();\n  const year = today.getFullYear();\n  const month = String(today.getMonth() + 1).padStart(2, '0');\n  const random = Math.random().toString(36).substring(2, 8).toUpperCase();\n  const invoiceId = `FAC-${year}${month}-${random}`;\n  \n  // Calcular fechas\n  const fechaEmision = today.toISOString().split('T')[0];\n  const fechaVencimiento = new Date(today.getTime() + diasVencimiento * 24 * 60 * 60 * 1000)\n    .toISOString()\n    .split('T')[0];\n  \n  processedItems.push({\n    json: {\n      // Datos originales\n      ...data,\n      \n      // Datos calculados\n      invoice_id: invoiceId,\n      monto_base: montoBase,\n      iva_rate: ivaRate,\n      iva_monto: ivaMonto,\n      monto_total: montoTotal,\n      fecha_emision: fechaEmision,\n      fecha_vencimiento: fechaVencimiento,\n      moneda: 'EUR',\n      \n      // Metadata\n      proceso_timestamp: today.toISOString(),\n      periodo_facturacion: `${year}-${month}`\n    }\n  });\n}\n\nreturn processedItems;"
      },
