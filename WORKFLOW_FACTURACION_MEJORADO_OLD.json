    {
      "parameters": {
        "fromEmail": "sistema@tuempresa.com",
        "toEmail": "admin@tuempresa.com,contabilidad@tuempresa.com",
        "subject": "=📊 Reporte Facturación Mensual - {{ $json.periodo }}",
        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 700px; margin: 0 auto; padding: 20px; }\n    .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px; border-radius: 10px 10px 0 0; text-align: center; }\n    .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin: 20px 0; }\n    .stat-box { background: white; padding: 20px; border-radius: 8px; border: 2px solid #e0e0e0; text-align: center; }\n    .stat-label { color: #666; font-size: 14px; margin-bottom: 5px; }\n    .stat-value { font-size: 28px; font-weight: bold; color: #667eea; }\n    .clients-table { width: 100%; border-collapse: collapse; margin: 20px 0; background: white; }\n    .clients-table th { background: #f5f5f5; padding: 12px; text-align: left; border-bottom: 2px solid #667eea; }\n    .clients-table td { padding: 10px 12px; border-bottom: 1px solid #e0e0e0; }\n    .clients-table tr:hover { background: #f9f9f9; }\n    .footer { background: #f0f0f0; padding: 20px; text-align: center; border-radius: 0 0 10px 10px; }\n    .emoji { font-size: 24px; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <div class=\"emoji\">📊</div>\n      <h1 style=\"margin: 10px 0;\">Reporte de Facturación Mensual</h1>\n      <p style=\"margin: 0; opacity: 0.9;\">Periodo: {{ $json.periodo }}</p>\n      <p style=\"margin: 5px 0 0 0; font-size: 14px; opacity: 0.8;\">Generado: {{ $json.fecha_proceso }}</p>\n    </div>\n    \n    <div style=\"background: #fafafa; padding: 30px;\">\n      <h2 style=\"color: #667eea; margin-top: 0;\">📈 Resumen Ejecutivo</h2>\n      \n      <div class=\"stats-grid\">\n        <div class=\"stat-box\">\n          <div class=\"stat-label\">Facturas Emitidas</div>\n          <div class=\"stat-value\">{{ $json.total_facturas }}</div>\n        </div>\n        \n        <div class=\"stat-box\">\n          <div class=\"stat-label\">Total Facturado</div>\n          <div class=\"stat-value\" style=\"color: #10b981;\">{{ $json.total_facturado.toFixed(2) }} €</div>\n        </div>\n        \n        <div class=\"stat-box\">\n          <div class=\"stat-label\">Base Imponible</div>\n          <div class=\"stat-value\" style=\"color: #3b82f6; font-size: 22px;\">{{ $json.total_base.toFixed(2) }} €</div>\n        </div>\n        \n        <div class=\"stat-box\">\n          <div class=\"stat-label\">Total IVA</div>\n          <div class=\"stat-value\" style=\"color: #f59e0b; font-size: 22px;\">{{ $json.total_iva.toFixed(2) }} €</div>\n        </div>\n      </div>\n      \n      <h2 style=\"color: #667eea; margin-top: 40px;\">👥 Detalle por Cliente</h2>\n      \n      <table class=\"clients-table\">\n        <thead>\n          <tr>\n            <th>Cliente</th>\n            <th>Nº Factura</th>\n            <th style=\"text-align: right;\">Importe</th>\n          </tr>\n        </thead>\n        <tbody>\n          {{#each $json.clientes}}\n          <tr>\n            <td><strong>{{this.cliente}}</strong></td>\n            <td><code>{{this.factura}}</code></td>\n            <td style=\"text-align: right; font-weight: bold; color: #10b981;\">{{this.total.toFixed(2)}} €</td>\n          </tr>\n          {{/each}}\n        </tbody>\n      </table>\n      \n      <div style=\"background: #e0e7ff; padding: 20px; border-radius: 8px; margin-top: 30px; border-left: 4px solid #667eea;\">\n        <h3 style=\"margin-top: 0; color: #667eea;\">✅ Estado del Proceso</h3>\n        <ul style=\"margin: 10px 0;\">\n          <li>✅ Facturas generadas y guardadas en Google Drive</li>\n          <li>✅ Emails enviados a todos los clientes</li>\n          <li>✅ Histórico actualizado en Google Sheets</li>\n          <li>✅ Estados de clientes actualizados</li>\n        </ul>\n      </div>\n    </div>\n    \n    <div class=\"footer\">\n      <p style=\"margin: 0; color: #666;\"><strong>Sistema de Facturación Automática</strong></p>\n      <p style=\"margin: 5px 0 0 0; font-size: 12px; color: #999;\">Powered by n8n</p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
