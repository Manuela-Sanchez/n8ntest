    {
      "parameters": {
        "jsCode": "// Generar reporte resumen de facturación\nconst items = $input.all();\n\nlet totalFacturado = 0;\nlet totalIVA = 0;\nlet totalBase = 0;\nconst clientesFacturados = [];\n\nfor (const item of items) {\n  totalBase += item.json.monto_base;\n  totalIVA += item.json.iva_monto;\n  totalFacturado += item.json.monto_total;\n  \n  clientesFacturados.push({\n    cliente: item.json.cliente,\n    factura: item.json.invoice_id,\n    total: item.json.monto_total\n  });\n}\n\nconst today = new Date();\nconst periodo = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}`;\n\nreturn [{\n  json: {\n    periodo,\n    fecha_proceso: today.toISOString(),\n    total_facturas: items.length,\n    total_base: Math.round(totalBase * 100) / 100,\n    total_iva: Math.round(totalIVA * 100) / 100,\n    total_facturado: Math.round(totalFacturado * 100) / 100,\n    clientes: clientesFacturados\n  }\n}];"
      },
