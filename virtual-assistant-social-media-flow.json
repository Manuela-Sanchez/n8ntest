    },
    {
      "parameters": {
        "agent": "conversationalAgent",
        "promptType": "define",
        "text": "=Analiza los resultados de publicación en redes sociales y genera un resumen breve.\n\nResultados: {{ $json.data.toJsonString() }}",
        "options": {}
      },
      "id": "cc0a3cf8-0d38-44c4-807e-ec66a0c7520e",
