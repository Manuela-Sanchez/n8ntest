{
  "name": "🎯 Client Onboarding - Automatización Completa",
  "nodes": [
    {
      "id": "a1b2c3d4-5678-90ab-cdef-000000000001",
      "name": "Nuevo Cliente (Formulario)",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.1,
      "position": [240, 300],
      "webhookId": "client-onboarding-webhook-id",
      "parameters": {
        "path": "nuevo-cliente",
        "formTitle": "Formulario de Registro de Nuevo Cliente",
        "formDescription": "Complete la información del nuevo cliente para iniciar el proceso de onboarding automático",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Nombre Completo",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Teléfono",
              "fieldType": "text",
              "requiredField": false
            },
            {
              "fieldLabel": "Empresa",
              "fieldType": "text",
              "requiredField": false
            },
            {
              "fieldLabel": "Plan Contratado",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Básico - $29/mes"
                  },
                  {
                    "option": "Profesional - $79/mes"
                  },
                  {
                    "option": "Empresarial - $199/mes"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Notas Adicionales",
              "fieldType": "textarea",
              "requiredField": false
            }
          ]
        },
        "options": {
          "formSubmittedText": "¡Gracias! Su registro ha sido procesado. Recibirá un email de bienvenida en breve."
        }
      }
    },
    {
      "id": "a1b2c3d4-5678-90ab-cdef-000000000002",
      "name": "Preparar Datos del Cliente",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "clientId",
              "value": "={{ 'CLI-' + $now.format('YYYYMMDD') + '-' + Math.floor(Math.random() * 10000) }}",
              "type": "string"
            },
            {
              "name": "onboardingDate",
              "value": "={{ $now.format('YYYY-MM-DD HH:mm:ss') }}",
              "type": "string"
            },
            {
              "name": "status",
              "value": "Onboarding Iniciado",
              "type": "string"
            },
            {
              "name": "planPrice",
              "value": "={{ $('Nuevo Cliente (Formulario)').item.json['Plan Contratado'].includes('Básico') ? 29 : $('Nuevo Cliente (Formulario)').item.json['Plan Contratado'].includes('Profesional') ? 79 : 199 }}",
              "type": "number"
            },
            {
              "name": "planType",
              "value": "={{ $('Nuevo Cliente (Formulario)').item.json['Plan Contratado'].split(' - ')[0] }}",
              "type": "string"
            },
            {
              "name": "invoiceNumber",
              "value": "={{ 'INV-' + $now.format('YYYYMMDD') + '-' + Math.floor(Math.random() * 10000) }}",
              "type": "string"
            },
            {
              "name": "paymentDueDate",
              "value": "={{ $now.plus({ days: 15 }).format('YYYY-MM-DD') }}",
              "type": "string"
            },
            {
              "name": "followUpDate",
              "value": "={{ $now.plus({ days: 10 }).format('YYYY-MM-DD') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
