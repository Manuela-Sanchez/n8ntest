            "Empresa": "={{ $('Nuevo Cliente (Formulario)').item.json['Empresa'] || 'No proporcionado' }}",
            "Plan": "={{ $json.planType }}",
            "Precio": "={{ $json.planPrice }}",
            "Estado": "={{ $json.status }}",
            "Número Factura": "={{ $json.invoiceNumber }}",
            "Fecha Vencimiento Pago": "={{ $json.paymentDueDate }}",
            "Fecha Seguimiento": "={{ $json.followUpDate }}",
            "Notas": "={{ $('Nuevo Cliente (Formulario)').item.json['Notas Adicionales'] || '' }}"
