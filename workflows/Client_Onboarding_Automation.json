    {
      "id": "a1b2c3d4-5678-90ab-cdef-000000000010",
      "name": "Alerta de Seguimiento (Email Interno)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1560, 600],
      "parameters": {
        "fromEmail": "sistema@tuempresa.com",
        "toEmail": "ventas@tuempresa.com",
        "subject": "🔔 SEGUIMIENTO REQUERIDO: Cliente {{ $('Nuevo Cliente (Formulario)').item.json['Nombre Completo'] }}",
        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 700px; margin: 0 auto; padding: 20px; }\n    .header { background: #e74c3c; color: white; padding: 20px; text-align: center; border-radius: 10px 10px 0 0; }\n    .content { background: #f9f9f9; padding: 30px; border-radius: 0 0 10px 10px; }\n    .alert-box { background: #fff; border-left: 4px solid #e74c3c; padding: 15px; margin: 20px 0; }\n    .info-table { width: 100%; border-collapse: collapse; margin: 20px 0; background: white; }\n    .info-table td { padding: 10px; border-bottom: 1px solid #ddd; }\n    .info-table td:first-child { font-weight: bold; width: 200px; background: #ecf0f1; }\n    .action-items { background: #d4edda; border-left: 4px solid #28a745; padding: 15px; margin: 20px 0; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h2>🔔 Alerta de Seguimiento de Cliente</h2>\n    </div>\n    <div class=\"content\">\n      <div class=\"alert-box\">\n        <h3>⏰ Acción Requerida</h3>\n        <p>Han pasado <strong>10 días</strong> desde el onboarding del siguiente cliente. Es momento de hacer seguimiento.</p>\n      </div>\n      \n      <h3>📋 Información del Cliente:</h3>\n      <table class=\"info-table\">\n        <tr>\n          <td>ID Cliente</td>\n          <td>{{ $('Preparar Datos del Cliente').item.json.clientId }}</td>\n        </tr>\n        <tr>\n          <td>Nombre</td>\n          <td>{{ $('Nuevo Cliente (Formulario)').item.json['Nombre Completo'] }}</td>\n        </tr>\n        <tr>\n          <td>Email</td>\n          <td>{{ $('Nuevo Cliente (Formulario)').item.json['Email'] }}</td>\n        </tr>\n        <tr>\n          <td>Teléfono</td>\n          <td>{{ $('Nuevo Cliente (Formulario)').item.json['Teléfono'] || 'No proporcionado' }}</td>\n        </tr>\n        <tr>\n          <td>Empresa</td>\n          <td>{{ $('Nuevo Cliente (Formulario)').item.json['Empresa'] || 'Particular' }}</td>\n        </tr>\n        <tr>\n          <td>Plan Contratado</td>\n          <td>{{ $('Preparar Datos del Cliente').item.json.planType }} (${{ $('Preparar Datos del Cliente').item.json.planPrice }}/mes)</td>\n        </tr>\n        <tr>\n          <td>Fecha de Onboarding</td>\n          <td>{{ $('Preparar Datos del Cliente').item.json.onboardingDate }}</td>\n        </tr>\n        <tr>\n          <td>Factura</td>\n          <td>{{ $('Generar Datos de Factura').item.json.invoiceNumber }} - Vencimiento: {{ $('Generar Datos de Factura').item.json.dueDate }}</td>\n        </tr>\n        <tr>\n          <td>Notas Iniciales</td>\n          <td>{{ $('Nuevo Cliente (Formulario)').item.json['Notas Adicionales'] || 'Sin notas' }}</td>\n        </tr>\n      </table>\n      \n      <div class=\"action-items\">\n        <h3>✅ Acciones Sugeridas:</h3>\n        <ul>\n          <li><strong>Verificar estado de pago</strong> - Comprobar si la factura ha sido pagada</li>\n          <li><strong>Llamada de seguimiento</strong> - Contactar al cliente para ver cómo va su onboarding</li>\n          <li><strong>Revisar uso de la plataforma</strong> - Verificar si el cliente está utilizando el servicio</li>\n          <li><strong>Identificar bloqueos</strong> - Preguntar si necesita ayuda o tiene dudas</li>\n          <li><strong>Oportunidad de upsell</strong> - Evaluar si el cliente podría beneficiarse de un plan superior</li>\n        </ul>\n      </div>\n      \n      <h3>📊 Timeline de Acciones Automáticas:</h3>\n      <ul>\n        <li>✅ Día 0: Formulario completado y email de bienvenida enviado</li>\n        <li>✅ Día 0: Factura generada y enviada</li>\n        <li>✅ Día 7: Recordatorio de pago enviado</li>\n        <li>🔔 Día 10: <strong>Seguimiento manual requerido (HOY)</strong></li>\n        <li>📅 Día 15: Vencimiento de pago</li>\n      </ul>\n      \n      <p style=\"margin-top: 30px; padding-top: 20px; border-top: 1px solid #ddd; color: #666; font-size: 12px;\">\n        <strong>Nota:</strong> Esta es una alerta automática generada por el sistema de onboarding. \n        Por favor, registra las acciones tomadas en el CRM.\n      </p>\n    </div>\n  </div>\n</body>\n</html>",
