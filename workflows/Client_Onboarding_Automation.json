    {
      "id": "a1b2c3d4-5678-90ab-cdef-000000000005",
      "name": "Generar Datos de Factura",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Generar datos completos de la factura\nconst clientData = $('Nuevo Cliente (Formulario)').first().json;\nconst processedData = $('Preparar Datos del Cliente').first().json;\n\nconst today = new Date();\nconst dueDate = new Date(today);\ndueDate.setDate(today.getDate() + 15);\n\n// Calcular impuestos (ejemplo: IVA 21%)\nconst subtotal = processedData.planPrice;\nconst taxRate = 0.21;\nconst taxAmount = subtotal * taxRate;\nconst total = subtotal + taxAmount;\n\n// Generar líneas de factura\nconst invoiceItems = [\n  {\n    description: `Plan ${processedData.planType} - Primer mes`,\n    quantity: 1,\n    unitPrice: subtotal,\n    amount: subtotal\n  }\n];\n\n// Crear objeto de factura completo\nconst invoice = {\n  invoiceNumber: processedData.invoiceNumber,\n  invoiceDate: today.toISOString().split('T')[0],\n  dueDate: processedData.paymentDueDate,\n  \n  // Datos del cliente\n  client: {\n    id: processedData.clientId,\n    name: clientData['Nombre Completo'],\n    email: clientData['Email'],\n    phone: clientData['Teléfono'] || 'No proporcionado',\n    company: clientData['Empresa'] || 'Particular'\n  },\n  \n  // Líneas de factura\n  items: invoiceItems,\n  \n  // Totales\n  subtotal: subtotal.toFixed(2),\n  taxRate: (taxRate * 100).toFixed(0),\n  taxAmount: taxAmount.toFixed(2),\n  total: total.toFixed(2),\n  \n  // Información de pago\n  paymentMethod: 'Transferencia bancaria / Tarjeta',\n  paymentStatus: 'Pendiente',\n  \n  // Notas\n  notes: 'Pago dentro de 15 días. Gracias por su confianza.'\n};\n\nreturn { json: invoice };"
      }
    },
    {
      "id": "a1b2c3d4-5678-90ab-cdef-000000000006",
      "name": "Email con Factura",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1120, 400],
      "parameters": {
        "fromEmail": "facturacion@tuempresa.com",
        "toEmail": "={{ $json.client.email }}",
        "subject": "Factura {{ $json.invoiceNumber }} - Tu Empresa",
        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 700px; margin: 0 auto; padding: 20px; }\n    .invoice-header { background: #2c3e50; color: white; padding: 30px; text-align: center; }\n    .invoice-details { background: #ecf0f1; padding: 20px; margin: 20px 0; }\n    .invoice-table { width: 100%; border-collapse: collapse; margin: 20px 0; }\n    .invoice-table th { background: #34495e; color: white; padding: 12px; text-align: left; }\n    .invoice-table td { padding: 12px; border-bottom: 1px solid #ddd; }\n    .totals { text-align: right; margin: 20px 0; }\n    .totals-row { padding: 8px 0; }\n    .total-final { font-size: 20px; font-weight: bold; color: #27ae60; }\n    .payment-info { background: #fff3cd; border-left: 4px solid #ffc107; padding: 15px; margin: 20px 0; }\n    .footer { text-align: center; margin-top: 30px; color: #666; font-size: 12px; border-top: 1px solid #ddd; padding-top: 20px; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"invoice-header\">\n      <h1>FACTURA</h1>\n      <p>{{ $json.invoiceNumber }}</p>\n    </div>\n    \n    <div class=\"invoice-details\">\n      <table style=\"width: 100%;\">\n        <tr>\n          <td style=\"width: 50%;\">\n            <h3>Emitido a:</h3>\n            <p>\n              <strong>{{ $json.client.name }}</strong><br>\n              {{ $json.client.company }}<br>\n              Email: {{ $json.client.email }}<br>\n              Teléfono: {{ $json.client.phone }}\n            </p>\n          </td>\n          <td style=\"width: 50%; text-align: right;\">\n            <h3>Detalles:</h3>\n            <p>\n              <strong>Fecha:</strong> {{ $now.format('DD/MM/YYYY') }}<br>\n              <strong>Vencimiento:</strong> {{ $json.dueDate }}<br>\n              <strong>ID Cliente:</strong> {{ $json.client.id }}<br>\n              <strong>Estado:</strong> <span style=\"color: #e74c3c;\">{{ $json.paymentStatus }}</span>\n            </p>\n          </td>\n        </tr>\n      </table>\n    </div>\n    \n    <table class=\"invoice-table\">\n      <thead>\n        <tr>\n          <th>Descripción</th>\n          <th style=\"text-align: center;\">Cantidad</th>\n          <th style=\"text-align: right;\">Precio Unit.</th>\n          <th style=\"text-align: right;\">Total</th>\n        </tr>\n      </thead>\n      <tbody>\n        {{ $json.items.map(item => `\n        <tr>\n          <td>${item.description}</td>\n          <td style=\"text-align: center;\">${item.quantity}</td>\n          <td style=\"text-align: right;\">$${item.unitPrice.toFixed(2)}</td>\n          <td style=\"text-align: right;\">$${item.amount.toFixed(2)}</td>\n        </tr>\n        `).join('') }}\n      </tbody>\n    </table>\n    \n    <div class=\"totals\">\n      <div class=\"totals-row\">\n        <span>Subtotal:</span> <strong>${{ $json.subtotal }}</strong>\n      </div>\n      <div class=\"totals-row\">\n        <span>IVA ({{ $json.taxRate }}%):</span> <strong>${{ $json.taxAmount }}</strong>\n      </div>\n      <div class=\"totals-row total-final\">\n        <span>TOTAL:</span> <strong>${{ $json.total }}</strong>\n      </div>\n    </div>\n    \n    <div class=\"payment-info\">\n      <h3>💳 Información de Pago</h3>\n      <p><strong>Método de pago:</strong> {{ $json.paymentMethod }}</p>\n      <p><strong>Fecha límite:</strong> {{ $json.dueDate }}</p>\n      <p>Por favor, realiza el pago antes de la fecha de vencimiento para evitar interrupciones en el servicio.</p>\n      <p style=\"margin-top: 15px;\">\n        <a href=\"https://tuempresa.com/pagar/{{ $json.invoiceNumber }}\" style=\"display: inline-block; background: #27ae60; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;\">Pagar Ahora</a>\n      </p>\n    </div>\n    \n    <p><strong>Notas:</strong> {{ $json.notes }}</p>\n    \n    <div class=\"footer\">\n      <p><strong>Tu Empresa S.A.</strong></p>\n      <p>Dirección de la empresa | Tel: +34 123 456 789 | Email: facturacion@tuempresa.com</p>\n      <p>CIF: B12345678 | Registro Mercantil de Madrid, Tomo 1234, Folio 56, Hoja M-78910</p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "YOUR_SMTP_CREDENTIAL_ID",
          "name": "SMTP - Email Empresarial"
        }
      }
    },
    {
      "id": "a1b2c3d4-5678-90ab-cdef-000000000007",
