      "parameters": {
        "jsCode": "try {\n  const mensaje = $input.first().json;\n  if (!mensaje || typeof mensaje !== 'object') throw new Error('Mensaje de Telegram inválido');\n  if (!mensaje.message) throw new Error('Campo message no encontrado');\n  const chat_id = mensaje.message?.chat?.id;\n  if (!chat_id) throw new Error('Chat ID no encontrado');\n  const nombre = ((mensaje.message?.from?.first_name || '') + ' ' + (mensaje.message?.from?.last_name || '')).trim();\n  if (!nombre || nombre.length < 2) throw new Error('Nombre vacío');\n  const mensaje_texto = mensaje.message?.text || '';\n  if (!mensaje_texto) throw new Error('Mensaje vacío');\n  if (mensaje_texto.length > 5000) throw new Error('Mensaje muy largo');\n  const username = mensaje.message?.from?.username || '';\n  return { json: { chat_id: chat_id.toString(), nombre_telegram: nombre, username, mensaje_texto, timestamp: new Date().toISOString(), error: false } };\n} catch (error) {\n  return { json: { error: true, error_tipo: 'IDENTIFICACION_FALLIDA', error_mensaje: error.message, chat_id: $input.first().json?.message?.chat?.id?.toString() || 'DESCONOCIDO' } };\n}"
      },
