    {
      "parameters": {
        "jsCode": "// PREPARAR DATOS CLIENTE\nconst inputData = $input.first().json;\nconst identificacion = $('🔍 Identificar Cliente').first().json;\nconst tareas = $('📋 Consultar Tareas').all().flatMap(item => item.json);\nconst finanzas = $('💰 Consultar Finanzas').all().flatMap(item => item.json);\n\nlet datosCliente = {\n  chat_id: identificacion.chat_id,\n  cliente: identificacion.nombre_telegram,\n  proyecto_id: inputData.proyecto_id || '',\n  servicio_contratado: inputData.tipo || 'Consultoría General',\n  estado_proyecto: inputData.estado || 'Nuevo',\n  progreso_global: inputData.progreso || '0%',\n  mensaje_texto: identificacion.mensaje_texto,\n  timestamp: identificacion.timestamp,\n  es_nuevo: !inputData.proyecto_id,\n  tareas: tareas,\n  tareas_totales: tareas.length,\n  tareas_completadas: tareas.filter(t => t.estado === 'Completada').length,\n  finanzas: finanzas,\n  total_gastos: finanzas.reduce((sum, f) => sum + (parseFloat(f.Amount) || 0), 0)\n};\n\nreturn { json: datosCliente };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-720, 144],
      "id": "preparar-datos",
      "name": "📦 Preparar Datos Cliente"
    },
    {
      "parameters": {
        "jsCode": "// DESGLOSADOR DE PROYECTOS\nconst proyecto = $input.first().json;\nconst descripcion = proyecto.mensaje_texto || '';\n\nconst plantillas = {\n  'Consultoría General': [\n    { descripcion: '🔍 Análisis inicial', tiempo: '1h', prioridad: '🔴 Alta', categoria: 'Análisis' },\n    { descripcion: '📋 Planificación', tiempo: '2h', prioridad: '🔴 Alta', categoria: 'Planificación' },\n    { descripcion: '🛠️ Implementación', tiempo: '4h', prioridad: '🟡 Media', categoria: 'Implementación' },\n    { descripcion: '🧪 Pruebas', tiempo: '2h', prioridad: '🟡 Media', categoria: 'Testing' },\n    { descripcion: '📞 Seguimiento', tiempo: '1h', prioridad: '🟢 Baja', categoria: 'Soporte' }\n  ]\n};\n\nconst tareasGeneradas = plantillas['Consultoría General'];\n\nconst tiempoTotal = tareasGeneradas.reduce((total, t) => total + parseInt(t.tiempo), 0);\n\nconst diasEntrega = Math.max(3, Math.ceil(tiempoTotal / 8));\nconst fechaEntrega = new Date();\nfechaEntrega.setDate(fechaEntrega.getDate() + diasEntrega);\n\nreturn {\n  json: {\n    ...proyecto,\n    tareas_generadas: tareasGeneradas,\n    tareas_totales: proyecto.tareas_totales + tareasGeneradas.length,\n    tiempo_total_estimado: `${tiempoTotal}h`,\n    fecha_entrega_estimada: fechaEntrega.toISOString().split('T')[0]\n  }\n};"
      },
